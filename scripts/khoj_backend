#!/usr/bin/env bash
# One-line MyAPI Khoj backend switch: archive (fat) <-> wave1 (lean snapshot)
# Usage: khoj-backend [wave1|archive|toggle|status]
set -euo pipefail

ENV_FILE="${MYAPI_ENV_FILE:-/data/repos/MyAPI/.env}"
SERVICE="${MYAPI_SERVICE:-context-refinery.service}"

ARCHIVE_URL="http://localhost:42110"
ARCHIVE_NOTES="/home/saboor/khoj-data/notes"
WAVE1_URL="http://localhost:42111"
WAVE1_NOTES="/data/corpus-hot/v1-notes"

usage() {
  echo "Usage: khoj-backend [wave1|archive|toggle|status]"
  echo "  wave1   — lean snapshot (port 42111, /data/corpus-hot/v1-notes)"
  echo "  archive — full old corpus (port 42110, ~/khoj-data/notes)"
  echo "  toggle  — flip between wave1 and archive"
  echo "  status  — show current target (default)"
}

current_backend() {
  if [[ -f "$ENV_FILE" ]] && grep -q '^KHOJ_BACKEND=' "$ENV_FILE" 2>/dev/null; then
    grep '^KHOJ_BACKEND=' "$ENV_FILE" | head -1 | cut -d= -f2-
    return
  fi
  if [[ -f "$ENV_FILE" ]] && grep -q '42111' "$ENV_FILE" 2>/dev/null; then
    echo wave1
  else
    echo archive
  fi
}

apply_backend() {
  local target="$1"
  local url notes
  case "$target" in
    wave1)
      url="$WAVE1_URL"
      notes="$WAVE1_NOTES"
      ;;
    archive)
      url="$ARCHIVE_URL"
      notes="$ARCHIVE_NOTES"
      ;;
    *)
      echo "Unknown backend: $target" >&2
      usage >&2
      exit 1
      ;;
  esac

  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing $ENV_FILE" >&2
    exit 1
  fi

  # Rewrite the three backend keys in place; keep the rest of .env
  local tmp
  tmp="$(mktemp)"
  awk -v b="$target" -v u="$url" -v n="$notes" '
    BEGIN { has_b=0; has_u=0; has_n=0 }
    /^KHOJ_BACKEND=/ { print "KHOJ_BACKEND=" b; has_b=1; next }
    /^KHOJ_URL=/ { print "KHOJ_URL=" u; has_u=1; next }
    /^KHOJ_NOTES_DIR=/ { print "KHOJ_NOTES_DIR=" n; has_n=1; next }
    { print }
    END {
      if (!has_b) print "KHOJ_BACKEND=" b
      if (!has_u) print "KHOJ_URL=" u
      if (!has_n) print "KHOJ_NOTES_DIR=" n
    }
  ' "$ENV_FILE" >"$tmp"
  mv "$tmp" "$ENV_FILE"

  echo "Set KHOJ_BACKEND=$target"
  echo "  KHOJ_URL=$url"
  echo "  KHOJ_NOTES_DIR=$notes"
  echo "Restarting $SERVICE ..."
  sudo systemctl restart "$SERVICE"
  sleep 1
  systemctl is-active "$SERVICE"
  # Live process check
  local pid
  pid="$(systemctl show -p MainPID --value "$SERVICE" 2>/dev/null || true)"
  if [[ -n "${pid:-}" && "$pid" != "0" && -r "/proc/$pid/environ" ]]; then
    echo -n "Process env: "
    tr '\0' '\n' <"/proc/$pid/environ" | grep -E '^KHOJ_(URL|NOTES_DIR|BACKEND)=' | paste -sd' ' -
  fi
  curl -sS --max-time 5 http://127.0.0.1:8000/health 2>/dev/null | python3 -m json.tool 2>/dev/null || true
}

cmd="${1:-status}"
case "$cmd" in
  status|-s|--status)
    cur="$(current_backend)"
    echo "backend: $cur"
    if [[ -f "$ENV_FILE" ]]; then
      grep -E '^KHOJ_(BACKEND|URL|NOTES_DIR)=' "$ENV_FILE" || true
    fi
    curl -sS --max-time 5 http://127.0.0.1:8000/health 2>/dev/null \
      | python3 -c "import sys,json; d=json.load(sys.stdin); print('live:', d.get('khoj_url'), 'notes via env')" 2>/dev/null || true
    ;;
  wave1|archive)
    apply_backend "$cmd"
    ;;
  toggle|flip)
    cur="$(current_backend)"
    if [[ "$cur" == "wave1" ]]; then
      apply_backend archive
    else
      apply_backend wave1
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
