# Copy to .env and fill before `docker compose up`.
# Never commit .env.

POSTGRES_USER=khoj
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=khoj

KHOJ_ADMIN_EMAIL=admin@local
KHOJ_ADMIN_PASSWORD=change-me-admin
KHOJ_DJANGO_SECRET_KEY=change-me-django-secret

# Host port published for Khoj API
KHOJ_HOST_PORT=42110

# Image pin — leave latest for first try; pin after verified
KHOJ_IMAGE=ghcr.io/khoj-ai/khoj:latest

# Absolute paths recommended on Mini
# Example Mini:
#   KHOJ_NOTES_HOST_PATH=/Users/you/khoj-data/notes
#   KHOJ_MODELS_HOST_PATH=/Users/you/khoj-engine/models
KHOJ_NOTES_HOST_PATH=./notes
KHOJ_MODELS_HOST_PATH=./models
