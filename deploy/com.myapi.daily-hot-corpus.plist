<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install:
    cp deploy/com.myapi.daily-hot-corpus.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.myapi.daily-hot-corpus 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.myapi.daily-hot-corpus.plist
  Manual:
    bash scripts/run_daily_hot_corpus.sh
  Env: MYAPI_KHOJ_URL (default khoj-vm-restore Tailscale)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.myapi.daily-hot-corpus</string>
  <key>WorkingDirectory</key>
  <string>/Users/sab-mini/repos/MyAPI</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sab-mini/repos/MyAPI/scripts/run_daily_hot_corpus.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/sab-mini/.local/bin</string>
    <key>HOME</key>
    <string>/Users/sab-mini</string>
    <key>MYAPI_REPO</key>
    <string>/Users/sab-mini/repos/MyAPI</string>
    <key>MYAPI_KHOJ_URL</key>
    <string>http://100.88.54.98:42110</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/sab-mini/Library/Logs/myapi-daily-hot-corpus.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sab-mini/Library/Logs/myapi-daily-hot-corpus.err.log</string>
</dict>
</plist>
